{
  "comment": "what the filesync plugin adds to an app's AndroidManifest.xml, see .github/scripts/add-capacitor-plugins.mjs",
  "cleartext": true,
  "permissions": [
    "android.permission.INTERNET",
    "android.permission.ACCESS_NETWORK_STATE",
    "android.permission.ACCESS_WIFI_STATE",
    "android.permission.CHANGE_WIFI_MULTICAST_STATE",
    "android.permission.FOREGROUND_SERVICE",
    "android.permission.FOREGROUND_SERVICE_DATA_SYNC",
    "android.permission.POST_NOTIFICATIONS",
    "android.permission.ACCESS_FINE_LOCATION"
  ],
  "services": [
    { "name": "dev.zugriff.filesync.SyncService",     "foregroundServiceType": "dataSync" },
    { "name": "dev.zugriff.filesync.TransferService", "foregroundServiceType": "dataSync" }
  ]
}
