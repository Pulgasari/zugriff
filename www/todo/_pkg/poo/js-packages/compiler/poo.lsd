# ======================================================================
# POO :: LANGUAGE SPECIFICATION DATA :: poo.lsd
# ======================================================================

# //////////// META ////////////////////////////////////////////////////

META PROP :: char  == ( a..z | A..Z )
META PROP :: digit == 0..9
META PROP :: id    == IDENTIFIER

META LIST :: builtins == Array Blob Bool Char Color Date Enum Generator List Map Number Queue Pattern Record RegExp Set Stack String Store Symbol Tree Tuple Union
META LIST :: keywords == as and break catch continue cpy do fail fn if kill loop in new obj or pkg ref return skip static switch use val yield
META LIST :: literals == false null true undefined
META LIST :: symbols  == a-z A-Z 0-9 _ @ $ & \#
META LIST :: puncts   == ; { } ( ) , [ ] #{ #( #[ :

META TABLE :: operators == (
  group         is String
  associativity is String
  precedence    is Number
  symbols       is String*
) {
  assign   left   100  ( = += -= *= /= ??= )
  compare  idk    200  ( ~= ~== == === != !== < > =< >= <=> || && ?? )
  additive left   300  ( + - )
  multi    left   400  ( * / % )
  pipe     left   500  ( >> >>> )
  idk      idk    600  ( |? |> |. )
  idk      idk    700  ( >=< )
}

# //////////// TOKENIZER ///////////////////////////////////////////////
# !!!  here order and relation of rules is part of the control flow  !!!

TKN :: COMMENT     == /\/\/[^\n]*/y
TKN :: WHITESPACE  == /[ \t\n\r]+/y

TKN :: KEYWORD     == @keywords
TKN :: LITERAL     == @literals
TKN :: PUNCT       == @puncts
TKN :: OPERATOR    == @operators

TKN :: NUMBER      == /0[xX][0-9a-fA-F_]+|0[bB][01_]+|\d[\d_]*\.\d[\d_]*(?:[eE][+-]?\d+)?|\d[\d_]*/y
TKN :: STRING      == /"(?:\\.|[^"\\])*"|'(?:\\.|[^'\\])*'|`(?:\\.|[^`])*`/y
TKN :: IDENTIFIER  == /[a-zA-Z_$][a-zA-Z0-9_$]*/y

# //////////// RULES ///////////////////////////////////////////////////

RULE :: Program       == Statement*
RULE :: Statement     == VarDecl | FnDecl | ExprStatement
RULE :: VarDecl       == ValDecl | ObjDecl

RULE :: Primary       == FnCall | ArrayLikeLiteral | STRING | NUMBER | IDENTIFIER
RULE :: Expr          == BinaryExpr | Primary

RULE :: IdentList     == [ IDENTIFIER+ `,`? ]
RULE :: Block         == `{` Statement* `}` => 2
RULE :: ParenCallArgs == `(` CallArgsList? `)` => 2
RULE :: SingleBareArg == LITERAL | IDENTIFIER | STRING | NUMBER
RULE :: CallArgsList  == NamedArgsList | ExprArgsList

# ------------ Declarations --------------------------------------------

#### FunctionDeclaration
META :: FnDecl
NODE == { identifier, args, body }
RULE == `fn` IDENTIFIER     `(` IdentList? `)`      Block     => identifier:2 args:4 body:6
RULE == `fn` IDENTIFIER `=` `(` IdentList? `)` `=>` Statement => identifier:2 args:5 body:8

#### ObjectDeclaration
META :: ObjDecl
NODE == { name: String, body: Block }
RULE == `obj` IDENTIFIER `=` Block => 2 4

#### ValDeclaration
META :: ValDecl
NODE == { name, value }
RULE == `val` IDENTIFIER `=` Expr `;` => 2 4

#### NamedPropDeclaration
META :: NamedPropDecl
NODE == { key, value }
RULE == IDENTIFIER `:` Expr => 1 3

# ------------ Statements -----------------------------------------------

#### ExpressionStatement
META :: ExprStatement
NODE == { expression }
RULE == Expr `;` => 1

# ------------ Expressions ---------------------------------------------

#### BinaryExpression
META :: BinaryExpr
NODE == { left, operator, right }
RULE == Primary OPERATOR Primary => 1 2 3

# ------------ Functions -----------------------------------------------

#### FunctionCall
META :: FnCall
NODE == { callee, args }
RULE == IDENTIFIER ( ParenCallArgs | SingleBareArg ) => 1 2

#### ExpressionArgumentsList
META :: ExprArgsList
NODE == { items }
RULE == [ Expr+ `,`? ]:items

#### NamedArgumentsList
META :: NamedArgsList
NODE == { args }
RULE == [ NamedPropDecl+ `,`? ]:args

# ------------ Objects -------------------------------------------------

#### ArrayLikeLiteral
META :: ArrayLikeLiteral
NODE == { kind, elements }
RULE == `#{` NamedArgsList? `}` => `Record` 2
RULE == `#(` ExprArgsList?  `)` => `Tuple`  2
RULE == `#[` ExprArgsList?  `]` => `List`   2
RULE ==  `[` ExprArgsList?  `]` => `Array`  2

# //////////// SYNTAX HIGHLIGHTING /////////////////////////////////////

HL :: COMMENT == `comment.line`
HL :: KEYWORD == `keyword.control`
HL :: LITERAL == `constant.language`
HL :: NUMBER  == `constant.numeric`
HL :: STRING  == `string.quoted`
