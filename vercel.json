{
  "rewrites": [
    {
      "source"      : "/:kind(apps|tools)(/)?",
      "destination" : "/index.html?kind=:kind"
    },
    {
      "source"      : "/:appname(/)?",
      "destination" : "/app.html?app=:appname"
    },
    {
      "source"      :      "/:appname/:path*",
      "destination" : "/apps/:appname/:path*"
    }
  ]
}
