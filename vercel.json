{
  "rewrites": [
    {
      "source"      :      "/:appname/",
      "destination" : "/apps/:appname/index.html"
    },
    {
      "source"      :      "/:appname",
      "destination" : "/apps/:appname/index.html"
    },
    {
      "source"      :      "/:appname/:path*",
      "destination" : "/apps/:appname/:path*"
    },
     {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "(?<app>(?!www)[^.]+)\\.zugriff\\.dev"
        }
      ],
      "destination": "/apps/:app/index.html"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "(?<app>(?!www)[^.]+)\\.zugriff\\.dev"
        }
      ],
      "destination": "/apps/:app/:path*"
    },
  ]
}
