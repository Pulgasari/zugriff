{
  "trailingSlash": true,
  "rewrites": [
    {
      "source"      : "/(apps|tools)(/)?",
      "destination" : "/index.html"
    },
    {
      "source"      : "/:appname(.*)(/)?",      
      "destination" : "/app.html?app=:appname"
    },
    {
      "source"      :      "/:appname/:path*",
      "destination" : "/apps/:appname/:path*"
    }
  ]
}
