{
  "rewrites": [
    {
      "source"      : "/:kind(apps2|tools2)(/)?",
      "destination" : "/index.html?kind=:kind"
    },
    {
      "source"      : "/:kind(apps|tools)(/)?",
      "destination" : "/:kind.html"
    },
    {
      "source"      :      "/:appname/",
      "destination" : "/apps/:appname/index.html"
    },
    {
      "source"      :      "/:appname",
      "destination" : "/apps/:appname/index.html"
    },
    {
      "source"      :      "/:appname/:path*",
      "destination" : "/apps/:appname/:path*"
    }
  ]
}
