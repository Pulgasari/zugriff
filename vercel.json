{
  "rewrites": [
    {
      "source"      :      "/:appname/",
      "destination" : "/apps/:appname/index.html"
    },
    {
      "source"      :      "/:appname",
      "destination" : "/apps/:appname/index.html"
    },
    {
      "source"      :      "/:appname/:path*",
      "destination" : "/apps/:appname/:path*"
    }
  ]
}
