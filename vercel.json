{
  "trailingSlash": true,
  "rewrites": [
    {
      "source"      : "/(apps|tools)(/)?",
      "destination" : "/index.html"
    },
    {
      "source"      : "/:appname(audio-manager|code|ebooks|feeds|files|gifmaker|image-editor|image-viewer|icons|notes|podcasts|videoplayer)(/)?",      
      "destination" : "/app.html?app=:appname"
    },
    {
      "source"      :      "/:appname/:path*",
      "destination" : "/apps/:appname/:path*"
    }
  ]
}
